# Токен від @BotFather
BOT_TOKEN=123456:ABC-DEF...

# Telegram ID адмінів (через кому, дізнатись у @userinfobot)
ADMIN_IDS=111111111

# Канал, куди публікуються батли (бот має бути там адміном)
CHANNEL_ID=@my_photobattle

# Скільки фото в одному батлі (2–10)
BATTLE_SIZE=2

# Текст поста-батлу. {n} = номер батлу. Можна HTML: <b>жирний</b>, <i>курсив</i>. \n = новий рядок
BATTLE_TEXT="⚔️ <b>Батл №{n}</b>\n\nЯке фото краще? Голосуй кнопками під постом 👇"

# Через скільки годин після /open_photos закривати прийом (0 = вручну)
AUTO_CLOSE_HOURS=24

# true = адмін перевіряє кожне фото перед публікацією; false = одразу в чергу
MODERATION=false

# Голосувати можуть тільки підписники каналу
REQUIRE_SUBSCRIPTION=true

# Не показувати ніки авторів у каналі
ANONYMOUS=true

THEME=Вільна тема
PRIZE=Зірки Telegram або гроші — уточнюється
VOTING_END=буде оголошено
