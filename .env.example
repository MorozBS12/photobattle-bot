# Токен від @BotFather
BOT_TOKEN=123456:ABC-DEF...

# Твій Telegram ID (дізнатись у @userinfobot). Кілька — через кому
ADMIN_IDS=111111111,222222222

# Канал, куди публікуються фото (бот має бути там адміном)
CHANNEL_ID=@my_photobattle

# Голосувати можуть тільки підписники каналу (true/false)
REQUIRE_SUBSCRIPTION=true

# Не показувати ніки авторів під фото в каналі (true/false)
ANONYMOUS=true

# Тексти конкурсу
THEME=Осінь у твоєму місті
PRIZE=500 грн на картку + роль у Discord
DEADLINE=15 листопада, 20:00
VOTING_END=20 листопада, 20:00
